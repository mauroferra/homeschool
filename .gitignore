# ---- Secrets & environment ----
# Ignore all local env files but keep example/template files trackable.
.env
.env.*
!.env.example
!*.env.example
.envrc
credentials.json

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Build output & bundler caches ----
dist/
**/dist/
build/
out/
.vite/
eslintcache
*.tsbuildinfo

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Tests & coverage ----
coverage/
.nyc_output/
.tmp-test-*/

# ---- Runtime data (SQLite DB, uploads, seeds) ----
data/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.bak
uploads/

# ---- Dependency/package manager caches ----
.npm/
.yarn/
.pnpm-store/
.eslintcache
.pnp.*
.yarn/*.cached
.yarn/cache
.yarn/unplugged

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Misc ----
*.pid
*.seed
*.pid.lock
.env.enc