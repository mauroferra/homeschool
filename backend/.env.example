NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# sqlite (default, no server needed) or postgres / mysql
DB_DIALECT=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homeschool
DB_USER=app
DB_PASSWORD=app
DB_STORAGE=./data/app.db

ADMIN_EMAIL=admin@homeschool.app
ADMIN_PASSWORD=admin123

UPLOADS_DIR=./data/uploads
RESET_TOKEN_TTL_MINUTES=30
RATE_WINDOW_MS=900000
RATE_MAX=100
