{
  "name": "homeschool-backend",
  "version": "1.0.0",
  "description": "Czech–Italian Hybrid Curriculum API",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node scripts/seed/run-seed.js",
    "test": "NODE_ENV=test DB_STORAGE=:memory: node --test 'tests/**/*.test.js'",
    "docs": "node src/app.js --docs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3"
  }
}
