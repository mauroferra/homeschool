{
  "name": "homeschool-backend",
  "version": "1.0.0",
  "description": "Czech–Italian Hybrid Curriculum API",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node scripts/seed/run-seed.js",
    "test": "NODE_ENV=test DB_STORAGE=:memory: node --test tests/",
    "docs": "node src/app.js --docs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  }
}
